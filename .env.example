# ─── Site ──────────────────────────────────────────────────────────
# Public URL, used for canonical tags, sitemap, Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.youragency.com

# ─── Database (Supabase) ───────────────────────────────────────────
# Project Settings → API. The service role key is SERVER-ONLY. Never expose it to the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "Nexora <hello@youragency.com>"
EMAIL_FROM="Nexora <hello@youragency.com>"
# Where new-lead alerts go (comma-separated for several)
LEAD_NOTIFICATION_EMAIL=sales@youragency.com

# ─── Spam protection (optional: Cloudflare Turnstile) ──────────────
# Leave both empty to rely on honeypot + rate limiting only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Booking embed (Cal.com or Calendly) ───────────────────────────
# e.g. https://cal.com/your-agency/discovery-call or https://calendly.com/your-agency/30min
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-agency/discovery-call

# ─── Analytics (optional) ──────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Admin ─────────────────────────────────────────────────────────
# Password for /admin. Use a long random value.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Random string (32+ chars) used to sign the admin session cookie.
ADMIN_SESSION_SECRET=replace-with-32-plus-random-characters
